{% if test_scenario['values']['openshift'] == 'true' %}
# This test's Pods hardcode runAsUser/fsGroup 1000 (OpenSearch, DataHub) and
# 1001 (Bitnami MySQL/Kafka), and three init containers run as root -- all
# outside the UID range OpenShift assigns to the namespace, so `restricted-v2`
# rejects every Pod.
---
kind: Role
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: use-integration-tests-scc
rules:
  - apiGroups:
      - security.openshift.io
    resources:
      - securitycontextconstraints
    resourceNames:
      - privileged
    verbs:
      - use
---
# The charts create their own ServiceAccounts, so most subjects below name
# accounts that do not exist yet: the grant must precede `helm install`, which
# starts workloads right away (`datahub-system-update` runs as a pre-install
# hook).
kind: RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: use-integration-tests-scc
subjects:
  # OpenSearch and the test's own Jobs run as `default`.
  - kind: ServiceAccount
    name: default
  - kind: ServiceAccount
    name: prerequisites-kafka
  - kind: ServiceAccount
    name: prerequisites-mysql
  # datahub-frontend and datahub-gms.
  - kind: ServiceAccount
    name: datahub-app-sa
  # datahub-system-update and datahub-system-update-nonblk.
  - kind: ServiceAccount
    name: datahub-operator-sa
roleRef:
  kind: Role
  name: use-integration-tests-scc
  apiGroup: rbac.authorization.k8s.io
{% endif %}
